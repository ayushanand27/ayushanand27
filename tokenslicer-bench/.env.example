# ---- Worker (cheap) model provider: deepseek | openrouter | groq | custom ----
WORKER_PROVIDER=deepseek

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Only for WORKER_PROVIDER=custom (any OpenAI-compatible endpoint):
WORKER_API_KEY=

# Optional overrides (defaults depend on provider):
# WORKER_BASE_URL=https://api.deepseek.com
# WORKER_MODEL=deepseek-chat

# ---- Worker pricing, USD per 1M tokens (defaults are built in for deepseek/groq; VERIFY against the provider's pricing page) ----
# WORKER_PRICE_INPUT_MISS=0.28
# WORKER_PRICE_INPUT_HIT=0.028     # cached-prefix input price; leave unset if provider has no cache discount
# WORKER_PRICE_OUTPUT=0.42

# ---- Pipeline A (frontier) ----
# simulate = reuse Pipeline B's response and re-price its tokens at frontier rates (no frontier API spend)
# live     = really call FRONTIER_* below
PIPELINE_A_MODE=simulate
FRONTIER_PRICE_INPUT=3.00
FRONTIER_PRICE_OUTPUT=15.00
# FRONTIER_BASE_URL=https://api.openai.com/v1
# FRONTIER_API_KEY=
# FRONTIER_MODEL=

# ---- Currency / limits ----
USD_TO_INR=88.0
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_SEC=180
MAX_RETRIES=6
# Raw (unpruned) context is truncated to this many tokens so it fits the worker's context window.
RAW_CONTEXT_TOKEN_CAP=110000
# false = strict `git apply --check`; true = add --recount (forgives wrong hunk line counts)
GIT_APPLY_RECOUNT=false
